# X-Amplicon Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit real keys.
#
# LLM keys are only required for natural-language Agent orchestration.
# The deterministic workflow can run without any key:
#   python process.py cli-only-workflow
#   python process.py run-pipeline-config --params pipeline_params.yaml

# ---------------------------------------------------------------------------
# Option A: Generic (works with any OpenAI-compatible proxy or relay)
# ---------------------------------------------------------------------------
LLM_API_KEY=sk-your-actual-key-here
LLM_API_BASE=https://your-custom-proxy-url.com/v1
DEFAULT_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Option B: Direct Anthropic
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# DEFAULT_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Option C: Direct OpenAI
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# DEFAULT_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Option D: Alibaba Qwen via DashScope OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# LLM_API_KEY=sk-your-dashscope-key
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEFAULT_MODEL=openai/qwen-max

# ---------------------------------------------------------------------------
# Option E: DeepSeek via their OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# LLM_API_KEY=sk-your-deepseek-key
# LLM_API_BASE=https://api.deepseek.com/v1
# DEFAULT_MODEL=openai/deepseek-chat

# ---------------------------------------------------------------------------
# Option F: Google Gemini (native, no proxy needed)
# ---------------------------------------------------------------------------
# LLM_API_KEY=AIza...
# DEFAULT_MODEL=gemini/gemini-2.0-flash-exp

# ---------------------------------------------------------------------------
# Optional Agent skills
# ---------------------------------------------------------------------------
# Required only for PubMed literature retrieval through Biopython Entrez.
# NCBI_EMAIL=your_email@example.com
# NCBI_API_KEY=optional-ncbi-api-key

# Optional override for JSONL tool-call traces.
# X_AMPLICON_AGENT_TRACE_PATH=run_logs/agent_tool_trace.jsonl

# Optional override for Agent evaluation JSONL events.
# X_AMPLICON_AGENT_EVAL_LOG_PATH=run_logs/agent_evaluation_log.jsonl
